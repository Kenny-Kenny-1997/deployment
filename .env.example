# MySQL connection string. Replace with your actual credentials.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/social_pulse"

# JWT secrets - generate strong random strings for production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret-for-refresh-tokens"

# Token lifetimes
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
